{
  "name": "react-modular-datepicker",
  "version": "0.0.11",
  "description": "A modular, lightweight, and type-safe React datepicker and calendar component with headless hooks for single, multiple, and range selection.",
  "author": "",
  "license": "MIT",
  "homepage": "https://react-modular-datepicker.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dragate/react-modular-datepicker.git"
  },
  "bugs": {
    "url": "https://github.com/Dragate/react-modular-datepicker/issues"
  },
  "keywords": [
    "react",
    "react-component",
    "datepicker",
    "date-picker",
    "date-range-picker",
    "daterangepicker",
    "calendar",
    "calendar-component",
    "headless",
    "headless-ui",
    "react-hook",
    "hooks",
    "modular",
    "customizable",
    "date-range",
    "date",
    "dayjs",
    "tailwind",
    "tailwindcss",
    "typescript",
    "i18n",
    "localization"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./useDates": {
      "types": "./dist/useDates.d.ts",
      "import": "./dist/useDates.js",
      "require": "./dist/useDates.cjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "dayjs": "^1.11.20",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "dayjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dayjs": "^1.11.20",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  }
}