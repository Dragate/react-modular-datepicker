{
  "name": "react-modular-datepicker-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm run -p \"/^dev:.*/\"",
    "dev:rmd": "pnpm --filter react-modular-datepicker dev",
    "dev:docs": "pnpm --filter docs dev",
    "build:rmd": "pnpm --filter react-modular-datepicker build",
    "build:docs": "pnpm --filter docs build",
    "test": "pnpm --filter react-modular-datepicker test"
  },
  "devDependencies": {
    "semver": "^7.8.5"
  }
}