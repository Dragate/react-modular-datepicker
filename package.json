{
  "name": "react-modular-datepicker",
  "version": "0.0.3",
  "description": "Another react datepicker",
  "scripts": {
    "dev": "pnpm run -p \"/^dev:.*/\"",
    "dev:watch": "vite build --watch",
    "dev:css": "tailwindcss -i src/index.css -o dist/index.css --watch",
    "dev:example": "pnpm --filter example-app-router dev",
    "build": "pnpm run build:js && pnpm run build:css",
    "build:js": "vite build",
    "build:css": "tailwindcss -i src/index.css -o dist/index.css",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "react",
    "react-component",
    "datepicker",
    "date-picker",
    "date-range-picker",
    "daterangepicker",
    "calendar",
    "calendar-component",
    "headless",
    "headless-ui",
    "react-hook",
    "hooks",
    "modular",
    "customizable",
    "date-range",
    "date",
    "dayjs",
    "tailwind",
    "tailwindcss",
    "typescript",
    "i18n",
    "localization"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "dayjs": "^1.11.20",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "dayjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dayjs": "^1.11.20",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "semver": "^7.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dragate/react-modular-datepicker.git"
  },
  "homepage": "https://github.com/Dragate/react-modular-datepicker#readme",
  "bugs": {
    "url": "https://github.com/Dragate/react-modular-datepicker/issues"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./useDates": {
      "import": {
        "types": "./dist/useDates.d.ts",
        "default": "./dist/useDates.mjs"
      },
      "require": {
        "types": "./dist/useDates.d.ts",
        "default": "./dist/useDates.js"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.mjs"
      },
      "require": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      }
    },
    "./dist/index.css": "./dist/index.css"
  }
}