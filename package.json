{
  "name": "react-modular-datepicker-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm run -p \"/^dev:.*/\"",
    "dev:watch": "pnpm --filter react-modular-datepicker dev:watch",
    "dev:css": "pnpm --filter react-modular-datepicker dev:css",
    "dev:docs": "pnpm --filter docs dev",
    "build": "pnpm --filter react-modular-datepicker build",
    "build:docs": "pnpm --filter docs build",
    "test": "pnpm --filter react-modular-datepicker test",
    "test:unit": "pnpm --filter react-modular-datepicker test:unit",
    "test:e2e": "pnpm --filter react-modular-datepicker test:e2e"
  },
  "devDependencies": {
    "semver": "^7.8.5"
  }
}