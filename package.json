{
  "name": "react-modular-datepicker",
  "version": "0.0.2-canary.17",
  "description": "Another react datepicker",
  "scripts": {
    "dev": "pnpm run -p \"/^dev:.*/\"",
    "dev:watch": "bunchee -w",
    "dev:example": "next dev examples/basic",
    "build": "bunchee -m",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/cli": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "bunchee": "^6.10.0",
    "jsdom": "^29.1.1",
    "next": "^16.2.6",
    "postcss": "^8.5.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-modular-datepicker": "workspace:*",
    "semver": "^7.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "dayjs": "^1.11.20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/es/index.mjs",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.mts",
        "default": "./dist/es/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./useDates": {
      "import": {
        "types": "./dist/es/useDates.d.mts",
        "default": "./dist/es/useDates.mjs"
      },
      "require": {
        "types": "./dist/cjs/useDates.d.ts",
        "default": "./dist/cjs/useDates.js"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/es/utils.d.mts",
        "default": "./dist/es/utils.mjs"
      },
      "require": {
        "types": "./dist/cjs/utils.d.ts",
        "default": "./dist/cjs/utils.js"
      }
    },
    "./dist/index.css": "./dist/index.css"
  }
}