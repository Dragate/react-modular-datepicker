{
  "name": "react-modular-datepicker",
  "version": "0.0.5-canary.0",
  "description": "A modular, lightweight, and type-safe React datepicker and calendar component with headless hooks for single, multiple, and range selection.",
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/Dragate/react-modular-datepicker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dragate/react-modular-datepicker.git"
  },
  "bugs": {
    "url": "https://github.com/Dragate/react-modular-datepicker/issues"
  },
  "keywords": [
    "react",
    "react-component",
    "datepicker",
    "date-picker",
    "date-range-picker",
    "daterangepicker",
    "calendar",
    "calendar-component",
    "headless",
    "headless-ui",
    "react-hook",
    "hooks",
    "modular",
    "customizable",
    "date-range",
    "date",
    "dayjs",
    "tailwind",
    "tailwindcss",
    "typescript",
    "i18n",
    "localization"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "pnpm run -p \"/^dev:.*/\"",
    "dev:watch": "vite build --watch",
    "dev:css": "tailwindcss -i src/index.css -o dist/index.css --watch",
    "dev:example": "pnpm --filter example-app-router dev",
    "dev:docs": "pnpm --filter docs dev",
    "build": "pnpm run build:js && pnpm run build:css",
    "build:docs": "pnpm run build && pnpm --filter docs build",
    "build:js": "vite build",
    "build:css": "tailwindcss -i src/index.css -o dist/index.css",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=e2e"
  },
  "peerDependencies": {
    "dayjs": "^1.11.20",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "dayjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "semver": "^7.8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.1.0",
    "vite": "^8.3.0"
  }
}